# Copy this file to .env for local development. Every value below already works:
# the keys are the public test credentials published by each service, which always
# validate and never show a real challenge. Replace them with your own to see the
# real widgets.
#
# On Vercel, set these as project environment variables instead. Real environment
# variables always win over this file.

SECRET_KEY=demo-only-not-a-real-secret-key
DEBUG=true

# Comma separated. Vercel's own deployment hostnames are added automatically, so
# this only matters locally or for a custom domain.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=

# Provider used by CaptchaFormMixin and by CaptchaField() without an alias.
# One of: none, math, turnstile, recaptcha, hcaptcha
CAPTCHA_DRIVER=math

# Number of reverse proxies you control in front of the app. 0 ignores
# X-Forwarded-For entirely. On Vercel this defaults to 1 on its own.
TRUSTED_PROXY_COUNT=0

# The test keys below report a fixed hostname of their own rather than the one
# the widget was solved on, so hostname verification has to be off for them.
# Turn it on once you use your own keys.
CAPTCHA_VERIFY_HOSTNAME=false

# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# https://developers.google.com/recaptcha/docs/faq
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# https://docs.hcaptcha.com/#integration-testing-test-keys
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
